{
  "name": "@krapwoo/ds-viewer",
  "version": "0.4.7",
  "license": "MIT",
  "type": "module",
  "description": "A browsable, always-current catalog for an Expo / React Native design system.",
  "repository": {
    "type": "git",
    "url": "https://github.com/krapwoo/design-system-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/krapwoo/design-system-viewer/issues"
  },
  "homepage": "https://github.com/krapwoo/design-system-viewer#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "ds-viewer": "dist/cli/main.js"
  },
  "exports": {
    ".": "./native/catalog/index.ts",
    "./config": {
      "types": "./config/index.ts",
      "default": "./dist/config/index.js"
    },
    "./generated": "./native/catalog/generated.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "native/catalog",
    "!native/catalog/**/__tests__",
    "starter-kit",
    "dist/cli",
    "dist/config",
    "dist/native",
    "config/index.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-web": "*"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "dependencies": {
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "puppeteer": "^25.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test 'cli/**/*.test.ts' 'config/**/*.test.ts' 'native/catalog/__tests__/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "kit:dev": "npm run build && cd kit-host && node node_modules/@krapwoo/ds-viewer/dist/cli/main.js dev",
    "check:catalog": "npm run build && node scripts/checkCatalogConsole.mjs kit-host",
    "check:doctor": "npm run build && cd kit-host && node node_modules/@krapwoo/ds-viewer/dist/cli/main.js doctor --ci",
    "check:types": "tsc --noEmit -p kit-host",
    "release": "node scripts/release.mjs"
  }
}
